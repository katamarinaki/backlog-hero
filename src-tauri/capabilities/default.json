{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://store.steampowered.com/*" },
        { "url": "https://steamcommunity.com/*" },
        { "url": "https://github.com/*" },
        { "url": "https://steamid.io/*" }
      ]
    }
  ]
}
